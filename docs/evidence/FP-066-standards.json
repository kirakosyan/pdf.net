  "decisions": [
    "Profile metadata alone never authorizes conversion output; a complete independent exact-input/profile observation is required",
    "No implicit font substitution, arbitrary semantic tagging, attachment removal, transparency flattening or decryption",
    "Explicit ICC/metadata/identifier repair; PDF/A-1 CIDSet repair only from a complete explicit source mapping",
    "Generic version downgrade remains refused; a private candidate path retains typed feature/signature guards and cannot copy output before independent validation"
  ],
  "limitations": [
    "Complete primary ISO 19005 texts and expert review are not retained by this source experiment; full normative/conformance qualification remains mandatory",
    "Original small fixtures and an external test-only host do not qualify arbitrary repairs, semantics, OS isolation or production readiness"
  ]
