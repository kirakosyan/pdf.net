<Project>
  <!-- Shared candidate metadata. Every pack entry point still invokes the production gate. -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <PackageId>$(MSBuildProjectName)</PackageId>
    <IsPackable>true</IsPackable>
    <Authors>Armen Kirakosyan</Authors>
    <Description>Fluent.Pdf SDK component. Publication requires complete production qualification.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/kirakosyan/pdf.net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/kirakosyan/pdf.net</PackageProjectUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <FluentPdfRoot>$(MSBuildThisFileDirectory)..</FluentPdfRoot>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="$(FluentPdfRoot)/README.md;$(FluentPdfRoot)/LICENSE" />
    <None Include="$(FluentPdfRoot)/README.md;$(FluentPdfRoot)/LICENSE" Pack="true" PackagePath="/" />
    <None Update="$(FluentPdfRoot)/third-party/**/*" Pack="false" />
    <!-- Retain the complete notice inventory, including separately identified analysis tools. -->
    <Content Include="$(FluentPdfRoot)/third-party/**/*.txt;$(FluentPdfRoot)/third-party/**/*.md;$(FluentPdfRoot)/third-party/**/*.json" Pack="true" PackagePath="notices/%(RecursiveDir)" />
  </ItemGroup>
  <Target Name="RequireProductionQualification" BeforeTargets="GenerateNuspec">
    <Exec Command="pwsh -NoProfile -File &quot;$(FluentPdfRoot)/eng/assert-production-ready.ps1&quot; -Stage BeforePack -EvidenceDirectory &quot;$(FluentPdfEvidenceDirectory)&quot;" />
  </Target>
  <Target Name="CoupleSdkPackageVersions" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)">
        <ProjectVersion>[$(PackageVersion)]</ProjectVersion>
      </_ProjectReferencesWithVersions>
    </ItemGroup>
  </Target>
</Project>
