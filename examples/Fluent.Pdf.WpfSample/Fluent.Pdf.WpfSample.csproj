<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net472;net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType><IsPackable>false</IsPackable>
    <RuntimeIdentifier Condition="'$(TargetFramework)' == 'net472'">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(TargetFramework)' == 'net472'">x64</PlatformTarget>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net8.0-windows'">8.0.32</RuntimeFrameworkVersion>
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net10.0-windows'">10.0.13</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Fluent.Pdf.Applications/Fluent.Pdf.Applications.csproj" />
    <ProjectReference Include="../../src/Fluent.Pdf.Rendering/Fluent.Pdf.Rendering.csproj" />
    <Compile Include="../Fluent.Pdf.ViewSample.Shared/ViewerSampleSession.cs" Link="ViewerSampleSession.cs" />
    <None Include="../../tests/Fluent.Pdf.Contract.Tests/Fixtures/Automation/original.pdf" Link="original.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Xml.Linq" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
